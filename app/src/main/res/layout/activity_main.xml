<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/velocity_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- BRAND LOGO -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="VeloCity Logo"
            android:src="@drawable/ic_velocity_logo" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VeloCity"
            android:textColor="@color/velocity_text_title"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fast, Safe &amp; Seamless Rides 🚕"
            android:textColor="@color/velocity_text_body"
            android:textSize="15sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="36dp" />

        <!-- CUSTOMER BUTTON CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Need a ride?"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/velocity_primary" />

            <Button
                android:id="@+id/btnCustomer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_primary"
                android:text="👤  RIDE AS CUSTOMER"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- DRIVER BUTTON CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Want to earn with us?"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/velocity_accent_orange" />

            <Button
                android:id="@+id/btnDriver"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_accent"
                android:text="🚕  DRIVE WITH VELOCITY"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- LOGIN BUTTON -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_rounded"
            android:text="🔐  LOG IN TO EXISTING ACCOUNT"
            android:textColor="@color/velocity_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>