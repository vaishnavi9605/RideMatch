<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/velocity_bg_light"
    android:padding="16dp"
    tools:context=".RideHistoryActivity">

    <!-- HEADER CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_rounded"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:elevation="2dp"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="VeloCity Logo"
            android:src="@drawable/ic_velocity_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 Ride History"
                android:textColor="@color/velocity_text_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalRidesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your past trips &amp; records"
                android:textColor="@color/velocity_text_body"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBackFromHistory"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- EMPTY STATE VIEW -->
    <TextView
        android:id="@+id/tvEmptyHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No ride history found yet 🚗\nYour completed trips will appear here!"
        android:textColor="@color/velocity_text_body"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- RIDE HISTORY RECYCLER / LIST VIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRideHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>