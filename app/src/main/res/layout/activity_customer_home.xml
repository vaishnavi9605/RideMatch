<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/velocity_bg_light"
    tools:context=".CustomerHomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:elevation="2dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="VeloCity Logo"
                android:src="@drawable/ic_velocity_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvCustomerWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_customer"
                    android:textColor="@color/velocity_text_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready for your next trip?"
                    android:textColor="@color/velocity_text_body"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ====================================================== -->
        <!-- ONGOING RIDE CARD -->
        <!-- ====================================================== -->

        <LinearLayout
            android:id="@+id/cardOngoingRide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_online"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="3dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">


            <!-- STATUS + FARE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvOngoingRideStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 SEARCHING FOR DRIVER..."
                    android:textColor="#008822"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOngoingRideFare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 ₹0"
                    android:textColor="@color/velocity_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ROUTE -->

            <TextView
                android:id="@+id/tvOngoingRideRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📍 Pickup → Destination"
                android:textColor="@color/velocity_text_title"
                android:textSize="13sp" />


            <!-- DRIVER -->

            <TextView
                android:id="@+id/tvOngoingDriverInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="👤 Driver: Finding driver..."
                android:textColor="@color/velocity_text_body"
                android:textSize="13sp" />


            <!-- PHONE -->

            <TextView
                android:id="@+id/tvOngoingDriverPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="📞 Contact: Not available"
                android:textColor="@color/velocity_text_body"
                android:textSize="13sp" />


            <!-- ETA -->

            <TextView
                android:id="@+id/tvOngoingDriverEta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="⏱ Waiting for driver..."
                android:textColor="@color/velocity_primary"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- CALL DRIVER -->

            <Button
                android:id="@+id/btnCallOngoingDriver"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:text="📞 CALL DRIVER"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false" />


            <!-- TRACK LIVE RIDE -->

            <Button
                android:id="@+id/btnTrackOngoingRide"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_accent"
                android:text="📍 TRACK LIVE RIDE ON MAP"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>


        <!-- ====================================================== -->
        <!-- WHERE TO GO -->
        <!-- ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginTop="16dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Where do you want to go? 📍"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/velocity_text_title" />


            <!-- PICKUP -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Pickup Location"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/velocity_primary"
                android:layout_marginTop="16dp" />


            <EditText
                android:id="@+id/etPickup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="Search pickup (e.g. Pune Station...)"
                android:inputType="textPostalAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp" />


            <ListView
                android:id="@+id/lvPickupResults"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:visibility="gone"
                android:background="#FFFFFF"
                android:elevation="6dp"
                android:divider="#E2E8F0"
                android:dividerHeight="1dp"
                android:layout_marginTop="4dp" />


            <!-- DESTINATION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Destination"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/velocity_accent_orange"
                android:layout_marginTop="16dp" />


            <EditText
                android:id="@+id/etDestination"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="Search destination (e.g. Phoenix Mall...)"
                android:inputType="textPostalAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp" />


            <ListView
                android:id="@+id/lvDestinationResults"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:visibility="gone"
                android:background="#FFFFFF"
                android:elevation="6dp"
                android:divider="#E2E8F0"
                android:dividerHeight="1dp"
                android:layout_marginTop="4dp" />


            <!-- FIND RIDE -->

            <Button
                android:id="@+id/btnFindRide"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_btn_accent"
                android:text="Find a Ride &amp; View Route 🚕"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false" />


            <!-- MAP -->

            <Button
                android:id="@+id/btnOpenMap"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:text="🗺️ Explore Map View"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false" />


            <!-- HISTORY -->

            <Button
                android:id="@+id/btnRideHistory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded"
                android:text="📜 My Ride History"
                android:textColor="@color/velocity_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>


        <!-- ====================================================== -->
        <!-- LOGOUT -->
        <!-- ====================================================== -->

        <Button
            android:id="@+id/btnCustomerLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_rounded"
            android:text="Logout"
            android:textColor="@color/velocity_status_offline"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>